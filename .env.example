# ==============================================================================
# Pay Manager: Environment Configuration
# All keys below are 100% OPTIONAL. Pay Manager runs out-of-the-box in 100% Direct Guest Mode with:
# - Free Public Currency API (https://open.er-api.com/v6/latest/USD)
# - LocalStorage / IndexedDB client persistence (No login required)
# - Direct WhatsApp Click-to-Chat Deep-Links (https://wa.me/?text=...)
# ==============================================================================

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DISABLE_HMR=true

# ==============================================================================
# GOOGLE ADS (ADSENSE / ADMOB) CONFIGURATION:
# Provide your Google AdSense Publisher ID and Banner Slot ID to activate live ads:
# ==============================================================================
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
VITE_ADSENSE_SLOT_ID="1234567890"

# OPTIONAL: Supabase Free Tier / Local PostgreSQL (defaults to high-capacity IndexedDB / LocalStorage)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OPTIONAL: JWT secret for session token signing (uses fallback default if empty)
JWT_SECRET=paymanager_free_tier_local_secret_2026
