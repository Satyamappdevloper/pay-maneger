# ==============================================================================
# EqualPay: Zero-Cost Environment Configuration
# All keys below are 100% OPTIONAL. EqualPay runs out-of-the-box locally with:
# - Free Public Currency API (https://open.er-api.com/v6/latest/USD)
# - LocalStorage / IndexedDB client persistence
# - Local Mock Authentication & Persona Switcher
# - Direct WhatsApp Click-to-Chat Deep-Links (https://wa.me/?text=...)
# ==============================================================================

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# OPTIONAL: Supabase Free Tier / Local PostgreSQL
# If omitted, EqualPay automatically uses high-capacity IndexedDB / LocalStorage & Local Memory DB.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OPTIONAL: JWT secret for session token signing (uses fallback default if empty)
JWT_SECRET=equalpay_free_tier_local_secret_2026

# OPTIONAL: Custom Currency API key (EqualPay uses https://open.er-api.com by default with zero keys required)
# EXCHANGE_RATE_API_KEY=
